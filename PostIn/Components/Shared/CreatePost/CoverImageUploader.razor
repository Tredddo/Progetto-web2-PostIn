@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@inject NotificationService NotificationService

<div class="card border-0 shadow-sm p-4 mb-3" style="border-radius: 1.1rem; border: 1px solid #e2e8f0; background: #ffffff;">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <label class="form-label fw-bold text-dark mb-0 d-flex align-items-center gap-1.5">
            <RadzenIcon Icon="image" Style="font-size: 1.15em; color: #4f46e5;" />
            Immagine di Copertina
            <span class="text-muted fw-normal small">(opzionale)</span>
        </label>

        @if (!string.IsNullOrEmpty(PreviewUrl))
        {
            <button type="button" 
                    class="btn btn-link text-danger text-decoration-none p-0 small d-flex align-items-center gap-1"
                    @onclick="RimuoviImmagine"
                    disabled="@IsProcessing">
                <RadzenIcon Icon="delete" Style="font-size: 0.9em;" />
                Rimuovi
            </button>
        }
    </div>

    <p class="text-muted small mb-3">
        Carica un'immagine JPG, PNG o WEBP (massimo 5 MB). Il salvataggio avverrà solo alla pubblicazione.
    </p>

    <div class="mb-2">
        <!-- @key forza il reset del file input nel browser quando il file non è valido -->
        <InputFile @key="inputFileId"
                   id="coverFileInput" 
                   OnChange="HandleFileSelected" 
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   class="form-control modern-input" 
                   disabled="@IsProcessing" />
    </div>

    @if (IsProcessing)
    {
        <div class="d-flex align-items-center gap-2 py-2 text-muted small">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <span>Elaborazione anteprima...</span>
        </div>
    }

    <!-- Anteprima Immagine -->
    @if (!string.IsNullOrWhiteSpace(PreviewUrl))
    {
        <div class="mt-3 position-relative rounded-3 overflow-hidden border shadow-sm" style="max-height: 14em;">
            <img src="@PreviewUrl" 
                 alt="Anteprima copertina" 
                 class="w-100 h-100" 
                 style="object-fit: cover; max-height: 14em;" />
        </div>
    }
</div>

@code {
    public class ImageData
    {
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
        public string Extension { get; set; } = string.Empty;
        public string PreviewUrl { get; set; } = string.Empty;
    }

    [Parameter] public string? PreviewUrl { get; set; }
    [Parameter] public EventCallback<ImageData?> OnImageChanged { get; set; }

    private bool IsProcessing = false;
    private Guid inputFileId = Guid.NewGuid(); // Chiave per resettare il campo HTML
    private const long MaxFileSize = 5 * 1024 * 1024; // 5 MB
    private readonly string[] PermittedExtensions = { ".jpg", ".jpeg", ".png", ".webp" };
    private readonly string[] PermittedMimeTypes = { "image/jpeg", "image/png", "image/webp" };

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var mimeType = file.ContentType.ToLowerInvariant();

        // 1. Controllo Estensione e MIME Type
        if (string.IsNullOrEmpty(extension) || 
            !PermittedExtensions.Contains(extension) || 
            !PermittedMimeTypes.Contains(mimeType))
        {
            ResetInputFile();
            await OnImageChanged.InvokeAsync(null);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "File non supportato",
                Detail = $"Il file '{file.Name}' non è un'immagine valida. Seleziona un file JPG, PNG o WEBP.",
                Duration = 4000
            });
            return;
        }

        // 2. Controllo Dimensione
        if (file.Size > MaxFileSize)
        {
            ResetInputFile();
            await OnImageChanged.InvokeAsync(null);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "File troppo grande",
                Detail = "L'immagine supera il limite massimo di 5 MB.",
                Duration = 3500
            });
            return;
        }

        IsProcessing = true;

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: MaxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var fileBytes = memoryStream.ToArray();

            var base64Preview = $"data:{file.ContentType};base64,{Convert.ToBase64String(fileBytes)}";

            var data = new ImageData
            {
                Bytes = fileBytes,
                Extension = extension,
                PreviewUrl = base64Preview
            };

            await OnImageChanged.InvokeAsync(data);
        }
        catch (Exception ex)
        {
            ResetInputFile();
            await OnImageChanged.InvokeAsync(null);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore Lettura",
                Detail = ex.Message,
                Duration = 4000
            });
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task RimuoviImmagine()
    {
        ResetInputFile();
        await OnImageChanged.InvokeAsync(null);
    }

    private void ResetInputFile()
    {
        // Cambiando il GUID, Blazor ricrea il nodo DOM <input type="file"> pulendolo
        inputFileId = Guid.NewGuid();
    }
}