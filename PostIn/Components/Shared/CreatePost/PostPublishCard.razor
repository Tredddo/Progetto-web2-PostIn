@using Radzen
@using Radzen.Blazor

<div class="card border-0 shadow-sm p-4 mb-3" style="border-radius: 1.1rem;">
    <h2 class="h6 fw-bold text-dark mb-3">Pubblicazione</h2>

    <div class="d-flex flex-column gap-2 mb-3 small text-muted">
        <div class="d-flex justify-content-between">
            <span>Stato:</span>
            <strong class="text-dark">@(IsEditMode ? "In Modifica" : "Nuova Bozza")</strong>
        </div>
    </div>

    <div class="d-grid gap-2">
        <RadzenButton ButtonType="ButtonType.Submit"
                      Icon="@(IsEditMode ? "save" : "publish")"
                      Text="@(IsEditMode ? "Salva Modifiche" : "Pubblica Ora")"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Medium"
                      IsBusy="@IsSaving"
                      BusyText="Salvataggio..."
                      Style="background-color: #4f46e5; border-radius: 0.65rem; padding: 0.65rem; font-weight: 600;" />

        <RadzenButton Variant="Variant.Outlined"
                      ButtonStyle="ButtonStyle.Secondary"
                      Text="Annulla ed Esci"
                      Size="ButtonSize.Medium"
                      Style="border-radius: 0.65rem; padding: 0.65rem;"
                      Click="OnCancel" />
    </div>
</div>

@code {
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}