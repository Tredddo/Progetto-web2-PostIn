@using Radzen
@using Radzen.Blazor

<div class="card border-0 shadow-sm p-4" style="border-radius:1em;">
    <h2 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
        <RadzenIcon Icon="timeline" Style="font-size:1.2em; color:#6366f1;" />
        Attività Recente
    </h2>

    @if (!UltimoAccesso.HasValue)
    {
        <p class="text-muted small mb-0">Nessun accesso precedente registrato.</p>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 text-muted small">
            <RadzenIcon Icon="login" Style="font-size:1.1em; color:#10b981;" />
            <span>Ultimo accesso: <strong class="text-dark">@UltimoAccesso.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></span>
        </div>
    }
</div>

@code {
    [Parameter]
    public DateTime? UltimoAccesso { get; set; }
}