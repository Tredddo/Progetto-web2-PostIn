@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using PostIn.Data
@using PostIn.Data.Entities
@using Radzen
@using Radzen.Blazor

@inject ApplicationDbContext DbContext
@inject NotificationService NotificationService

<div class="card border shadow-sm p-4 mb-4" style="border-radius: 0.85rem; border: 1px solid #e2e8f0 !important; background: #ffffff;">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <!-- Icona con contenitore a dimensione fissa -->
            <div class="p-2 rounded-3 bg-light text-primary border d-flex align-items-center justify-content-center flex-shrink-0" 
                style="width: 2.75rem; height: 2.75rem;">
                <RadzenIcon Icon="lock" Style="font-size: 1.25rem; color: #4f46e5;" />
            </div>

            <!-- Testi con corretta spaziatura verticale -->
            <div>
                <h3 class="h6 fw-bold text-dark mb-1 lh-sm">Sicurezza Account</h3>
                <p class="text-muted small mb-0 lh-sm">Modifica la password di accesso alla piattaforma intranet</p>
            </div>
        </div>

        <RadzenButton Text="@(isOpen ? "Annulla" : "Cambia Password")"
                      Icon="@(isOpen ? "close" : "key")"
                      Variant="@(isOpen ? Variant.Outlined : Variant.Filled)"
                      ButtonStyle="@(isOpen ? ButtonStyle.Secondary : ButtonStyle.Primary)"
                      Size="ButtonSize.Small"
                      Style="border-radius: 0.55rem; font-weight: 600;"
                      Click="ToggleForm" />
    </div>

    @if (isOpen)
    {
        <hr class="my-3 text-muted opacity-25" />

        <EditForm Model="model" OnValidSubmit="HandlePasswordChange" FormName="changePasswordForm">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        Password Attuale <span class="text-danger">*</span>
                    </label>
                    <InputText type="password" @bind-Value="model.PasswordAttuale" class="form-control modern-input" placeholder="Password attuale" />
                    <ValidationMessage For="() => model.PasswordAttuale" class="text-danger small mt-1" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        Nuova Password <span class="text-danger">*</span>
                    </label>
                    <InputText type="password" @bind-Value="model.NuovaPassword" class="form-control modern-input" placeholder="Min. 6 caratteri" />
                    <ValidationMessage For="() => model.NuovaPassword" class="text-danger small mt-1" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        Conferma Nuova <span class="text-danger">*</span>
                    </label>
                    <InputText type="password" @bind-Value="model.ConfermaNuovaPassword" class="form-control modern-input" placeholder="Ripeti nuova password" />
                    <ValidationMessage For="() => model.ConfermaNuovaPassword" class="text-danger small mt-1" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <RadzenButton Text="Chiudi"
                              Variant="Variant.Outlined"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Small"
                              Style="border-radius: 0.55rem;"
                              Click="ToggleForm" />

                <RadzenButton Text="Aggiorna Password"
                              Icon="check"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small"
                              ButtonType="ButtonType.Submit"
                              IsBusy="@isSaving"
                              Style="background-color: #4f46e5; border-radius: 0.55rem; font-weight: 600;" />
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int UserId { get; set; }

    private bool isOpen = false;
    private bool isSaving = false;
    private PasswordModel model = new();

    private void ToggleForm()
    {
        isOpen = !isOpen;
        if (!isOpen) model = new();
    }

    private async Task HandlePasswordChange()
    {
        if (isSaving || UserId <= 0) return;
        isSaving = true;

        try
        {
            var utente = await DbContext.Dipendenti.FindAsync(UserId);
            if (utente == null)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Errore",
                    Detail = "Profilo non trovato.",
                    Duration = 3500
                });
                return;
            }

            if (!PasswordHelper.VerifyPassword(model.PasswordAttuale, utente.PasswordHash))
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Password Errata",
                    Detail = "La password attuale non corrisponde.",
                    Duration = 3500
                });
                return;
            }

            if (PasswordHelper.VerifyPassword(model.NuovaPassword, utente.PasswordHash))
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Attenzione",
                    Detail = "La nuova password deve essere diversa da quella precedente.",
                    Duration = 3500
                });
                return;
            }

            var nuovoHash = PasswordHelper.HashPassword(model.NuovaPassword);

            utente.PasswordHash = nuovoHash;
            await DbContext.SaveChangesAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Aggiornata!",
                Detail = "Password modificata con successo.",
                Duration = 3000
            });

            ToggleForm();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isSaving = false;
        }
    }

    public class PasswordModel
    {
        [Required(ErrorMessage = "Inserisci la password attuale.")]
        public string PasswordAttuale { get; set; } = string.Empty;

        [Required(ErrorMessage = "Inserisci la nuova password.")]
        [MinLength(6, ErrorMessage = "Minimo 6 caratteri.")]
        public string NuovaPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Conferma la nuova password.")]
        [Compare(nameof(NuovaPassword), ErrorMessage = "Le password non coincidono.")]
        public string ConfermaNuovaPassword { get; set; } = string.Empty;
    }
}