@page "/subscriptions"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PostIn.Data
@using PostIn.Data.Entities
@using Radzen
@using Radzen.Blazor

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>Iscrizioni & Network - PostIn</PageTitle>

<RadzenNotification />

<div class="mx-auto" style="max-width: 56em;">

    <!-- INTESTAZIONE -->
    <header class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <RadzenIcon Icon="group" Style="font-size: 1.6em; color: #4f46e5;" />
                <h1 class="h3 fw-bold text-dark mb-0">Iscrizioni & Network</h1>
            </div>
            <p class="text-muted small mb-0 mt-1">
                Gestisci i colleghi che segui e visualizza chi segue le tue pubblicazioni.
            </p>
        </div>

        <!-- Conteggi Rapidi -->
        <div class="d-none d-sm-flex align-items-center gap-3">
            <div class="text-center px-3 py-1.5 bg-light rounded-3 border">
                <span class="d-block fw-bold text-dark h5 mb-0">@following.Count</span>
                <span class="text-muted" style="font-size: 0.75rem;">Seguiti</span>
            </div>
            <div class="text-center px-3 py-1.5 bg-light rounded-3 border">
                <span class="d-block fw-bold text-dark h5 mb-0">@followers.Count</span>
                <span class="text-muted" style="font-size: 0.75rem;">Follower</span>
            </div>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <p class="text-muted small mt-2">Caricamento del network in corso...</p>
        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- 1. SEZIONE RICERCA NUOVI COLLEGHI -->
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4" style="border-radius: 1em;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
                            <RadzenIcon Icon="person_search" Style="font-size: 1.2em; color: #6366f1;" />
                            Trova colleghi
                        </h2>
                        <span class="badge bg-light text-secondary border px-2.5 py-1 rounded-pill small">
                            @(tuttiDipendenti.Count(d => d.ID_Dipendente != currentUserId)) colleghi
                        </span>
                    </div>

                    <div class="input-group mb-2" style="border-radius: 0.65em; overflow: hidden;">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <RadzenIcon Icon="search" Style="font-size: 1.1em;" />
                        </span>
                        <input type="text"
                               class="form-control border-start-0 bg-light modern-search-input"
                               placeholder="Cerca per nome, cognome o username..."
                               @bind="searchQuery"
                               @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(searchQuery))
                        {
                            <button class="btn btn-light border-start-0 text-muted" type="button" @onclick="() => searchQuery = string.Empty">
                                <RadzenIcon Icon="close" Style="font-size: 1em;" />
                            </button>
                        }
                    </div>

                    <!-- Risultati Ricerca -->
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        var query = searchQuery.Trim();
                        var risultati = tuttiDipendenti
                            .Where(d => d.ID_Dipendente != currentUserId &&
                                        ($"{d.Nome} {d.Cognome}".Contains(query, StringComparison.OrdinalIgnoreCase) ||
                                         d.Username.Contains(query, StringComparison.OrdinalIgnoreCase)))
                            .ToList();

                        <div class="mt-3 d-flex flex-column gap-2">
                            @if (!risultati.Any())
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center py-5 px-3 text-muted border rounded-3 bg-light shadow-sm">
                                    <RadzenIcon Icon="search_off" Style="font-size: 2.5em; color: #94a3b8;" class="mb-2" />
                                    <span class="small">Nessun collega trovato per "<strong>@searchQuery</strong>"</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var d in risultati)
                                {
                                    var isFollowing = followingIds.Contains(d.ID_Dipendente);

                                    <div class="card border-0 shadow-sm p-3" style="border-radius: 0.85em;">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-3">
                                                <DiceBearAvatar Email="@d.Username" Style="width: 2.8em; height: 2.8em; border-radius: 50%; flex-shrink: 0;" />
                                                <div>
                                                    <h2 class="h6 fw-bold mb-0 text-dark">@d.Nome @d.Cognome</h2>
                                                    <span class="text-muted small">@@@d.Username</span>
                                                </div>
                                            </div>

                                            <RadzenButton Icon="@(isFollowing ? "person_remove" : "person_add")"
                                                          Text="@(isFollowing ? "Non seguire più" : "Segui")"
                                                          Variant="@(isFollowing ? Variant.Outlined : Variant.Filled)"
                                                          ButtonStyle="@(isFollowing ? ButtonStyle.Danger : ButtonStyle.Primary)"
                                                          Size="ButtonSize.Small"
                                                          Style="@(isFollowing ? "border-radius: 0.5em; font-size: 0.8rem;" : "border-radius: 0.5em; font-size: 0.8rem; background-color: #4f46e5;")"
                                                          IsBusy="@isActionLoading"
                                                          Click="() => ToggleFollow(d.ID_Dipendente)" />
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 2. COLONNA SINISTRA: CHI SEGUI -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 1em;">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
                            <RadzenIcon Icon="person_pin" Style="font-size: 1.2em; color: #6366f1;" />
                            Utenti Seguiti
                        </h2>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 small">
                            @following.Count
                        </span>
                    </div>
                    <p class="text-muted small mb-3">Colleghi e profili di cui segui aggiornamenti e articoli</p>

                    @if (!following.Any())
                    {
                        <div class="card border-0 p-5 text-center flex-grow-1 d-flex flex-column align-items-center justify-content-center bg-light" style="border-radius: 0.85em;">
                            <RadzenIcon Icon="person_off" Style="font-size: 3em; color: #94a3b8;" class="mb-2 d-block" />
                            <h3 class="h6 fw-bold text-dark mb-1">Non segui ancora nessun collega</h3>
                            <p class="text-muted small mb-0">Usa la ricerca in alto per trovare i tuoi colleghi.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2 overflow-auto" style="max-height: 32em;">
                            @foreach (var iscrizione in following)
                            {
                                var d = iscrizione.Followed;

                                <div class="card border-0 shadow-sm p-3" style="border-radius: 0.85em;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <DiceBearAvatar Email="@d.Username" Style="width: 2.8em; height: 2.8em; border-radius: 50%; flex-shrink: 0;" />
                                            <div>
                                                <h3 class="h6 fw-bold mb-0 text-dark">@d.Nome @d.Cognome</h3>
                                                <span class="text-muted small">@@@d.Username</span>
                                            </div>
                                        </div>

                                        <RadzenButton Icon="person_remove"
                                                      Text="Non seguire più"
                                                      Variant="Variant.Outlined"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Size="ButtonSize.Small"
                                                      Style="border-radius: 0.5em; font-size: 0.8rem;"
                                                      IsBusy="@isActionLoading"
                                                      Click="() => ToggleFollow(d.ID_Dipendente)" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 3. COLONNA DESTRA: I TUOI FOLLOWER -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 1em;">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
                            <RadzenIcon Icon="groups" Style="font-size: 1.2em; color: #6366f1;" />
                            I Miei Follower
                        </h2>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 small">
                            @followers.Count
                        </span>
                    </div>
                    <p class="text-muted small mb-3">Colleghi che seguono i tuoi articoli e aggiornamenti</p>

                    @if (!followers.Any())
                    {
                        <div class="card border-0 p-5 text-center flex-grow-1 d-flex flex-column align-items-center justify-content-center bg-light" style="border-radius: 0.85em;">
                            <RadzenIcon Icon="group_off" Style="font-size: 3em; color: #94a3b8;" class="mb-2 d-block" />
                            <h3 class="h6 fw-bold text-dark mb-1">Nessun follower al momento</h3>
                            <p class="text-muted small mb-0">Pubblica nuovi post per farti notare e ottenere follower!</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2 overflow-auto" style="max-height: 32em;">
                            @foreach (var iscrizione in followers)
                            {
                                var d = iscrizione.Follower;
                                var isFollowingBack = followingIds.Contains(d.ID_Dipendente);

                                <div class="card border-0 shadow-sm p-3" style="border-radius: 0.85em;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <DiceBearAvatar Email="@d.Username" Style="width: 2.8em; height: 2.8em; border-radius: 50%; flex-shrink: 0;" />
                                            <div>
                                                <h3 class="h6 fw-bold mb-0 text-dark">@d.Nome @d.Cognome</h3>
                                                <span class="text-muted small">@@@d.Username</span>
                                            </div>
                                        </div>

                                        <RadzenButton Icon="@(isFollowingBack ? "person_remove" : "person_add")"
                                                      Text="@(isFollowingBack ? "Non seguire più" : "Segui anche tu")"
                                                      Variant="@(isFollowingBack ? Variant.Outlined : Variant.Filled)"
                                                      ButtonStyle="@(isFollowingBack ? ButtonStyle.Danger : ButtonStyle.Primary)"
                                                      Size="ButtonSize.Small"
                                                      Style="@(isFollowingBack ? "border-radius: 0.5em; font-size: 0.8rem;" : "border-radius: 0.5em; font-size: 0.8rem; background-color: #4f46e5;")"
                                                      IsBusy="@isActionLoading"
                                                      Click="() => ToggleFollow(d.ID_Dipendente)" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    }
</div>

<style>
    .modern-search-input:focus {
        background-color: #ffffff !important;
        box-shadow: none !important;
        border-color: #818cf8 !important;
    }
</style>

@code {
    private bool isLoading = true;
    private bool isActionLoading = false;
    private string searchQuery = string.Empty;
    private int currentUserId = 0;

    private List<IscrizioniFollow> following = new();
    private List<IscrizioniFollow> followers = new();
    private HashSet<int> followingIds = new();
    private List<Dipendente> tuttiDipendenti = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdClaim, out currentUserId);

        await CaricaDati();
    }

    private async Task CaricaDati()
    {
        isLoading = true;
        try
        {
            tuttiDipendenti = await DbContext.Dipendenti
                .AsNoTracking()
                .OrderBy(d => d.Cognome)
                .ThenBy(d => d.Nome)
                .ToListAsync();

            following = await DbContext.IscrizioniFollow
                .AsNoTracking()
                .Where(f => f.FK_Follower == currentUserId)
                .Include(f => f.Followed)
                .OrderBy(f => f.Followed.Cognome)
                .ToListAsync();

            followers = await DbContext.IscrizioniFollow
                .AsNoTracking()
                .Where(f => f.FK_Followed == currentUserId)
                .Include(f => f.Follower)
                .OrderBy(f => f.Follower.Cognome)
                .ToListAsync();

            followingIds = following.Select(f => f.FK_Followed).ToHashSet();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore di caricamento",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleFollow(int targetId)
    {
        if (currentUserId <= 0 || isActionLoading || targetId == currentUserId) return;
        isActionLoading = true;

        try
        {
            var targetDipendente = tuttiDipendenti.FirstOrDefault(d => d.ID_Dipendente == targetId);
            var nomeTarget = targetDipendente != null ? $"{targetDipendente.Nome} {targetDipendente.Cognome}" : "il collega";

            var recordEsistente = await DbContext.IscrizioniFollow
                .FirstOrDefaultAsync(f => f.FK_Follower == currentUserId && f.FK_Followed == targetId);

            if (recordEsistente != null)
            {
                DbContext.IscrizioniFollow.Remove(recordEsistente);
                await DbContext.SaveChangesAsync();
                followingIds.Remove(targetId);

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Non segui più",
                    Detail = $"Hai smesso di seguire {nomeTarget}.",
                    Duration = 2500
                });
            }
            else
            {
                DbContext.IscrizioniFollow.Add(new IscrizioniFollow
                {
                    FK_Follower = currentUserId,
                    FK_Followed = targetId,
                    DataInizioInterazione = DateTime.UtcNow
                });
                await DbContext.SaveChangesAsync();
                followingIds.Add(targetId);

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Nuovo Follower",
                    Detail = $"Ora stai seguendo {nomeTarget}!",
                    Duration = 2500
                });
            }

            await CaricaDati();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = $"Impossibile aggiornare l'iscrizione: {ex.Message}",
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }
}