@page "/saved"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PostIn.Data
@using PostIn.Data.Entities
@using Radzen
@using Radzen.Blazor

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>Post Salvati - PostIn</PageTitle>

<div class="mx-auto" style="max-width: 52em;">

    <!-- INTESTAZIONE -->
    <header class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <RadzenIcon Icon="bookmark" Style="font-size: 1.6em; color: #4f46e5;" />
                <h1 class="h3 fw-bold text-dark mb-0">Post Salvati</h1>
            </div>
            <p class="text-muted small mb-0 mt-1">La tua lista privata degli articoli da leggere dopo</p>
        </div>

        @if (!isLoading && salvati.Any())
        {
            <span class="count-badge-header">
                <strong>@salvati.Count</strong> @(salvati.Count == 1 ? "articolo salvato" : "articoli salvati")
            </span>
        }
    </header>

    <!-- BARRA RICERCA NEI SALVATI -->
    @if (!isLoading && salvati.Any())
    {
        <div class="mb-4">
            <div class="input-group" style="border-radius: 0.65rem; overflow: hidden;">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <RadzenIcon Icon="search" Style="font-size: 1.1em;" />
                </span>
                <input type="text"
                       class="form-control border-start-0 modern-search-input"
                       placeholder="Cerca per titolo, contenuto o autore..."
                       @bind="filtroRicerca"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(filtroRicerca))
                {
                    <button class="btn btn-white border-start-0 text-muted" type="button" @onclick="() => filtroRicerca = string.Empty">
                        <RadzenIcon Icon="close" Style="font-size: 1em;" />
                    </button>
                }
            </div>
        </div>
    }

    <!-- STATI DI CARICAMENTO / EMPTY STATE / LISTA SALVATI -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <p class="text-muted mt-3 small">Caricamento dei tuoi post salvati...</p>
        </div>
    }
    else if (!salvati.Any())
    {
        <RadzenCard class="rz-shadow-sm p-5 text-center" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
            <RadzenIcon Icon="bookmark_border" Style="font-size: 3em; color: #94a3b8;" class="mb-3 d-block" />
            <h2 class="h5 fw-bold text-dark mb-1">Nessun articolo salvato</h2>
            <p class="text-muted small mb-3">
                Quando trovi un articolo interessante nel feed, clicca su <strong>Salva</strong> per ritrovarlo qui.
            </p>
            <div>
                <RadzenButton Icon="dynamic_feed"
                              Text="Esplora il Feed"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small"
                              Style="background-color: #4f46e5; border-radius: 0.55rem;"
                              Click='() => NavigationManager.NavigateTo("/")' />
            </div>
        </RadzenCard>
    }
    else
    {
        var filtrati = salvati
            .Where(s => string.IsNullOrWhiteSpace(filtroRicerca) ||
                        (s.Articolo?.Titolo.Contains(filtroRicerca, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (s.Articolo?.CorpoTesto.Contains(filtroRicerca, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (s.Articolo?.Autore != null &&
                         $"{s.Articolo.Autore.Nome} {s.Articolo.Autore.Cognome}".Contains(filtroRicerca, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        @if (!filtrati.Any())
        {
            <RadzenCard class="rz-shadow-sm p-4 text-center" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
                <RadzenIcon Icon="search_off" Style="font-size: 2.2em; color: #94a3b8;" class="mb-2 d-block" />
                <p class="text-muted small mb-0">Nessun articolo salvato corrisponde a "<strong>@filtroRicerca</strong>"</p>
            </RadzenCard>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-5">
                @foreach (var salvataggio in filtrati)
                {
                    var art = salvataggio.Articolo;

                    <RadzenCard class="rz-shadow-sm p-3 saved-card" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
                        <div class="d-flex gap-3 align-items-start">

                            <!-- Miniatura Copertina -->
                            @if (!string.IsNullOrWhiteSpace(art?.ImmagineCopertina))
                            {
                                <img src="@art.ImmagineCopertina"
                                     alt="Cover"
                                     class="flex-shrink-0 d-none d-sm-block cover-thumb" />
                            }
                            else
                            {
                                <div class="d-none d-sm-flex align-items-center justify-content-center bg-light border flex-shrink-0 cover-thumb">
                                    <RadzenIcon Icon="article" Style="font-size: 1.8em; color: #94a3b8;" />
                                </div>
                            }

                            <!-- Contenuto Articolo -->
                            <div class="flex-grow-1 min-w-0">
                                
                                <!-- Autore + Categorie -->
                                <div class="d-flex align-items-center justify-content-between mb-1.5 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <DiceBearAvatar Email="@art?.Autore?.Username" Style="width: 1.6em; height: 1.6em; border-radius: 0.4rem;" />
                                        <span class="text-dark fw-medium small">
                                            @(art?.Autore != null ? $"{art.Autore.Nome} {art.Autore.Cognome}" : "Anonimo")
                                        </span>
                                    </div>

                                    <div class="d-flex flex-wrap gap-1">
                                        @if (art?.ArticoloCategorie != null)
                                        {
                                            @foreach (var ac in art.ArticoloCategorie)
                                            {
                                                <span class="category-badge-sm">
                                                    #@ac.Categoria?.NomeCategoria
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>

                                <!-- Titolo -->
                                <h2 class="h6 fw-bold mb-1 text-truncate">
                                    <a href="/post/@salvataggio.FK_Articolo" class="text-dark text-decoration-none saved-title-link">
                                        @(art?.Titolo ?? "Articolo non disponibile")
                                    </a>
                                </h2>

                                <!-- Anteprima Corpo Testo -->
                                @if (art != null)
                                {
                                    <p class="text-muted small mb-2.5 saved-excerpt">
                                        @art.CorpoTesto
                                    </p>
                                }

                                <!-- Footer Scheda: Data Salvataggio & Azioni -->
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top flex-wrap gap-2">
                                    <span class="text-muted d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                        <RadzenIcon Icon="bookmark_added" Style="font-size: 0.95em; color: #d97706;" />
                                        Salvato il @salvataggio.DataSalvataggio.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </span>

                                    <div class="d-flex align-items-center gap-1.5">
                                        @if (art != null)
                                        {
                                            <RadzenButton Text="Leggi"
                                                          Icon="arrow_forward"
                                                          Variant="Variant.Outlined"
                                                          ButtonStyle="ButtonStyle.Primary"
                                                          Size="ButtonSize.Small"
                                                          Style="border-radius: 0.55rem; font-size: 0.78rem; padding: 0.25rem 0.65rem;"
                                                          Click='() => NavigationManager.NavigateTo($"/post/{salvataggio.FK_Articolo}")' />
                                        }

                                        <RadzenButton Icon="bookmark_remove"
                                                      Variant="Variant.Outlined"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Size="ButtonSize.Small"
                                                      Style="border-radius: 0.55rem; padding: 0.25rem 0.5rem;"
                                                      Title="Rimuovi dai salvati"
                                                      IsBusy="@isActionLoading"
                                                      Click="() => RimuoviSalvataggio(salvataggio.FK_Articolo)" />
                                    </div>
                                </div>

                            </div>
                        </div>
                    </RadzenCard>
                }
            </div>
        }
    }
</div>

<style>
    .modern-search-input:focus {
        background-color: #ffffff !important;
        box-shadow: none !important;
        border-color: #818cf8 !important;
    }

    .count-badge-header {
        background-color: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 0.55rem;
        padding: 0.35rem 0.75rem;
        font-size: 0.8rem;
    }

    .cover-thumb {
        width: 6.5em;
        height: 5.2em;
        object-fit: cover;
        border-radius: 0.55rem;
        border: 1px solid #e2e8f0;
    }

    .category-badge-sm {
        background-color: #f1f5f9;
        color: #4338ca;
        border: 1px solid #e2e8f0;
        border-radius: 0.35rem;
        padding: 0.1rem 0.45rem;
        font-size: 0.7rem;
        font-weight: 500;
    }

    .saved-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .saved-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05) !important;
    }

    .saved-title-link:hover {
        color: #4f46e5 !important;
    }

    .saved-excerpt {
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    private bool isLoading = true;
    private bool isActionLoading = false;
    private string filtroRicerca = string.Empty;
    private int currentUserId = 0;
    private List<SalvataggioDaLeggere> salvati = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdClaim, out currentUserId);

        await CaricaSalvati();
    }

    private async Task CaricaSalvati()
    {
        isLoading = true;
        try
        {
            salvati = await DbContext.SalvataggiDaLeggere
                .AsNoTracking()
                .AsSplitQuery()
                .Where(s => s.FK_Dipendente == currentUserId)
                .Include(s => s.Articolo)
                    .ThenInclude(a => a!.Autore)
                .Include(s => s.Articolo)
                    .ThenInclude(a => a!.ArticoloCategorie)
                    .ThenInclude(ac => ac.Categoria)
                .OrderByDescending(s => s.DataSalvataggio)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore di Caricamento",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RimuoviSalvataggio(int articoloId)
    {
        if (currentUserId <= 0 || isActionLoading) return;
        isActionLoading = true;

        try
        {
            var salvataggio = await DbContext.SalvataggiDaLeggere
                .FirstOrDefaultAsync(s => s.FK_Dipendente == currentUserId && s.FK_Articolo == articoloId);

            if (salvataggio != null)
            {
                DbContext.SalvataggiDaLeggere.Remove(salvataggio);
                await DbContext.SaveChangesAsync();

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Segnalibri",
                    Detail = "Articolo rimosso dai salvati.",
                    Duration = 2500
                });

                await CaricaSalvati();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = $"Impossibile rimuovere l'articolo: {ex.Message}",
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }
}