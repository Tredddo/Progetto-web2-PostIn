@page "/following"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PostIn.Data
@using PostIn.Data.Entities
@using Radzen
@using Radzen.Blazor

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>Utenti Seguiti - PostIn</PageTitle>

<RadzenNotification />

<div class="mx-auto" style="max-width:52em;">

    <!-- INTESTAZIONE -->
    <header class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
        <RadzenButton Icon="arrow_back" 
                      Variant="Variant.Text" 
                      ButtonStyle="ButtonStyle.Base" 
                      Size="ButtonSize.Medium" 
                      Click='() => NavigationManager.NavigateTo("/profile")' 
                      aria-label="Torna al Profilo" />
        <div>
            <h1 class="h3 fw-bold text-dark mb-0">Utenti Seguiti</h1>
            <p class="text-muted small mb-0">Colleghi e profili di cui segui aggiornamenti e post</p>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
        </div>
    }
    else if (!utentiSeguiti.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center" style="border-radius:1em;">
            <RadzenIcon Icon="person_off" Style="font-size:3em; color:#94a3b8;" class="mb-3 d-block" />
            <h2 class="h5 fw-bold text-dark">Non segui ancora nessun utente</h2>
            <p class="text-muted small mb-0">Esplora il feed per scoprire colleghi e iniziare a seguire i loro post.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var u in utentiSeguiti)
            {
                <div class="card border-0 shadow-sm p-3" style="border-radius:0.85em;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <DiceBearAvatar Email="@u.Username" Style="width: 2.8em; height: 2.8em; border-radius: 50%;" />
                            <div>
                                <h2 class="h6 fw-bold mb-0 text-dark">@u.Nome @u.Cognome</h2>
                                <span class="text-muted small">@@@u.Username</span>
                            </div>
                        </div>

                        <RadzenButton Icon="person_remove" 
                                      Text="Non seguire più" 
                                      Variant="Variant.Outlined" 
                                      ButtonStyle="ButtonStyle.Secondary" 
                                      Size="ButtonSize.Small" 
                                      Style="border-radius: 0.5em; font-size: 0.8rem;" 
                                      Click="() => SmettiDiSeguire(u.ID_Dipendente)" />
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private int currentUserId = 0;
    private CancellationTokenSource cts = new();
    private List<Dipendente> utentiSeguiti = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdClaim, out currentUserId);

        await CaricaSeguiti();
    }

    private async Task CaricaSeguiti()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync(cts.Token);

            utentiSeguiti = await (from f in context.IscrizioniFollow
                                   join d in context.Dipendenti on f.FK_Followed equals d.ID_Dipendente
                                   where f.FK_Follower == currentUserId
                                   select d)
                                   .AsNoTracking()
                                   .ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Navigazione annullata al cambio pagina
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = ex.Message,
                Duration = 2500
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SmettiDiSeguire(int targetUserId)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            await context.IscrizioniFollow
                .Where(f => f.FK_Follower == currentUserId && f.FK_Followed == targetUserId)
                .ExecuteDeleteAsync();

            utentiSeguiti.RemoveAll(u => u.ID_Dipendente == targetUserId);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Follow",
                Detail = "Non segui più questo profilo.",
                Duration = 2000
            });

            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = ex.Message,
                Duration = 2500
            });
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}