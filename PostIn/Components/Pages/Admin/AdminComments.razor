@page "/admin/comments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using PostIn.Data
@using PostIn.Data.Entities
@using PostIn.Services
@using Radzen
@using Radzen.Blazor

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SentimentService SentimentService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Gestione Commenti - Admin PostIn</PageTitle>

<RadzenNotification />
<RadzenDialog />

<div class="mx-auto" style="max-width: 74em;">

    <!-- INTESTAZIONE ADMIN -->
    <header class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger px-2.5 py-1 text-uppercase fw-bold" style="font-size: 0.7rem; border-radius: 0.35rem; letter-spacing: 0.05em;">
                    Admin
                </span>
                <h1 class="h3 fw-bold text-dark mb-0">Moderazione Commenti & Sentiment</h1>
            </div>
            <p class="text-muted small mb-0">Supervisiona i commenti e avvia l'analisi del sentiment on-demand per articolo tramite Azure AI</p>
        </div>

        <span class="count-badge-header">
            <strong>@commenti.Count</strong> @(commenti.Count == 1 ? "commento totale" : "commenti totali")
        </span>
    </header>

    <!-- NAVIGAZIONE ADMIN -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <a href="/admin/users" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="group" Style="font-size: 0.95em;" class="me-1" /> Utenti
        </a>
        <a href="/admin/categories" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="label" Style="font-size: 0.95em;" class="me-1" /> Categorie
        </a>
        <a href="/admin/posts" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="article" Style="font-size: 0.95em;" class="me-1" /> Articoli
        </a>
        <a href="/admin/comments" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-active">
            <RadzenIcon Icon="forum" Style="font-size: 0.95em;" class="me-1" /> Commenti
        </a>
    </div>

    <!-- FILTRI & AZIONI ON-DEMAND -->
    <RadzenCard class="rz-shadow-sm p-3 mb-4" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <div class="row g-3 align-items-end">
            <!-- Ricerca Testo -->
            <div class="col-md-4 col-lg-4">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">
                    Cerca Testo / Autore
                </label>
                <div class="input-group" style="border-radius: 0.55rem; overflow: hidden;">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <RadzenIcon Icon="search" Style="font-size: 1.1em;" />
                    </span>
                    <input type="text"
                           class="form-control border-start-0 modern-input"
                           placeholder="Cerca parole chiave..."
                           value="@filtroTesto"
                           @oninput="OnFiltroTestoChanged" />
                </div>
            </div>

            <!-- Filtro per Articolo Specifico -->
            <div class="col-md-4 col-lg-4">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">
                    Filtra per Articolo
                </label>
                <RadzenDropDown TValue="int?"
                                Data="@articoliDisponibili"
                                TextProperty="Titolo"
                                ValueProperty="ID_Articolo"
                                AllowClear="true"
                                Placeholder="Tutti gli articoli"
                                Value="@filtroArticoloId"
                                ValueChanged="@((int? val) => OnFiltroArticoloChanged(val))"
                                Style="width: 100%; border-radius: 0.55rem;" />
            </div>

            <!-- Pulsante Analisi Azure AI On-Demand -->
            <div class="col-md-4 col-lg-4 d-flex gap-2">
                <RadzenButton Icon="psychology"
                              Text="@(isAnalyzing ? "Analisi Azure in corso..." : "Analizza Post Selezionato")"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Medium"
                              Style="border-radius: 0.55rem; flex: 2; background-color: #4f46e5;"
                              IsBusy="@isAnalyzing"
                              Disabled="@(filtroArticoloId == null || isAnalyzing || isActionLoading)"
                              Click="AnalizzaCommentiArticoloSelezionato" />

                <RadzenButton Icon="filter_alt_off"
                              Text="Azzera"
                              Variant="Variant.Outlined"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Medium"
                              Style="border-radius: 0.55rem; flex: 1;"
                              Click="ResetFiltri" />
            </div>
        </div>
    </RadzenCard>

    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <span class="text-muted small">
            Visualizzati <strong>@commentiFiltrati.Count</strong> di <strong>@commenti.Count</strong> commenti
        </span>
    </div>

    <!-- TABELLA COMMENTI -->
    <RadzenCard class="rz-shadow-sm p-0 mb-5 overflow-hidden" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <RadzenDataGrid @ref="grid"
                        Data="@commentiFiltrati"
                        TItem="Commento"
                        IsLoading="@isLoading"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Pagina {0} di {1} ({2} commenti)"
                        EmptyText="Nessun commento trovato con i criteri selezionati."
                        class="rz-admin-grid">
            <Columns>

                <!-- Autore -->
                <RadzenDataGridColumn TItem="Commento" Property="Autore.Cognome" Title="Autore" MinWidth="170px">
                    <Template Context="c">
                        <div class="d-flex align-items-center gap-2 py-1">
                            <DiceBearAvatar Email="@c.Autore?.Username" Style="width: 2.2em; height: 2.2em; border-radius: 0.45rem; flex-shrink: 0;" />
                            <div class="min-w-0">
                                <span class="fw-bold text-dark d-block small text-truncate" style="max-width: 10rem;">
                                    @(c.Autore != null ? $"{c.Autore.Nome} {c.Autore.Cognome}" : "Anonimo")
                                </span>
                                <span class="text-muted" style="font-size: 0.72rem;">@@@c.Autore?.Username</span>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Testo Commento -->
                <RadzenDataGridColumn TItem="Commento" Property="TestoCommento" Title="Commento" MinWidth="220px">
                    <Template Context="c">
                        <div class="p-2 rounded-2 bg-light border text-dark" style="font-size: 0.85rem; line-height: 1.45; word-break: break-word;">
                            @c.TestoCommento
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Sentiment Azure AI -->
                <RadzenDataGridColumn TItem="Commento" Property="Sentiment" Title="Sentiment" Width="170px">
                    <Template Context="c">
                        <div class="d-flex flex-column gap-1">
                            <span class="badge @GetBadgeColor(c.Sentiment)" style="width: fit-content;">
                                @c.Sentiment
                            </span>
                            @if (c.Sentiment != "Da analizzare" && c.Sentiment != "Unknown")
                            {
                                <small class="text-muted" style="font-size: 0.68rem;">
                                    +@c.PositiveScore | ~@c.NeutralScore | -@c.NegativeScore
                                </small>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Articolo Collegato -->
                <RadzenDataGridColumn TItem="Commento" Property="Articolo.Titolo" Title="Articolo" MinWidth="160px">
                    <Template Context="c">
                        @if (c.Articolo != null)
                        {
                            <a href="/post/@c.FK_Articolo"
                               class="fw-semibold text-dark text-decoration-none admin-comment-link d-block text-truncate small"
                               title="@c.Articolo.Titolo">
                                <RadzenIcon Icon="article" Style="font-size: 0.9em;" class="me-1 text-muted" />
                                @c.Articolo.Titolo
                            </a>
                            <span class="text-muted" style="font-size: 0.7rem;">ID: #@c.FK_Articolo</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <!-- Data -->
                <RadzenDataGridColumn TItem="Commento" 
                                      Property="DataPubblicazione" 
                                      Title="Data" 
                                      Width="130px">
                    <Template Context="c">
                        <span class="text-muted small" style="font-size: 0.78rem;">
                            @c.DataPubblicazione.ToLocalTime().ToString("dd/MM/yy, HH:mm")
                        </span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Azioni -->
                <RadzenDataGridColumn TItem="Commento" Title="Azioni" Width="90px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                    <Template Context="c">
                        <RadzenButton Icon="delete"
                                      Variant="Variant.Outlined"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                                      Title="Elimina Commento"
                                      Disabled="@isActionLoading"
                                      Click="() => EliminaCommento(c)" />
                    </Template>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</div>

@code {
    private RadzenDataGrid<Commento>? grid;
    private bool isLoading = true;
    private bool isActionLoading = false;
    private bool isAnalyzing = false;
    private CancellationTokenSource cts = new();

    private List<Commento> commenti = new();
    private List<Commento> commentiFiltrati = new();
    private List<Articolo> articoliDisponibili = new();

    private string filtroTesto = string.Empty;
    private int? filtroArticoloId;

    protected override async Task OnInitializedAsync()
    {
        await CaricaDati();
    }

    private async Task CaricaDati()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync(cts.Token);

            articoliDisponibili = await context.Articoli
                .AsNoTracking()
                .OrderBy(a => a.Titolo)
                .ToListAsync(cts.Token);

            commenti = await context.Commenti
                .AsNoTracking()
                .Include(c => c.Autore)
                .Include(c => c.Articolo)
                .OrderByDescending(c => c.DataPubblicazione)
                .ToListAsync(cts.Token);

            ApplicaFiltri();
        }
        catch (OperationCanceledException)
        {
            // Pagina cambiata dall'utente in fase di caricamento
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore di Caricamento",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplicaFiltri()
    {
        commentiFiltrati = commenti.Where(c =>
            (string.IsNullOrWhiteSpace(filtroTesto) ||
             c.TestoCommento.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase) ||
             (c.Autore != null && $"{c.Autore.Nome} {c.Autore.Cognome}".Contains(filtroTesto, StringComparison.OrdinalIgnoreCase)) ||
             (c.Autore != null && c.Autore.Username.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase))) &&
            (!filtroArticoloId.HasValue || c.FK_Articolo == filtroArticoloId.Value)
        ).ToList();
    }

    private void OnFiltroTestoChanged(ChangeEventArgs e)
    {
        filtroTesto = e.Value?.ToString() ?? string.Empty;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void OnFiltroArticoloChanged(int? value)
    {
        filtroArticoloId = value;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void ResetFiltri()
    {
        filtroTesto = string.Empty;
        filtroArticoloId = null;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private async Task AnalizzaCommentiArticoloSelezionato()
    {
        if (filtroArticoloId == null || isAnalyzing) return;

        isAnalyzing = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();

            var targetCommenti = await context.Commenti
                .Where(c => c.FK_Articolo == filtroArticoloId.Value && (c.Sentiment == "Da analizzare" || c.Sentiment == "Neutral"))
                .ToListAsync();

            if (!targetCommenti.Any())
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Nessun commento da analizzare",
                    Detail = "I commenti per questo articolo sono già stati tutti analizzati.",
                    Duration = 3000
                });
                return;
            }

            foreach (var comm in targetCommenti)
            {
                var result = await SentimentService.AnalyzeSentimentAsync(comm.TestoCommento);
                comm.Sentiment = result.Sentiment;
                comm.PositiveScore = result.Pos;
                comm.NeutralScore = result.Neu;
                comm.NegativeScore = result.Neg;
            }

            await context.SaveChangesAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Analisi Completata",
                Detail = $"Analizzati con successo {targetCommenti.Count} commenti tramite Azure AI.",
                Duration = 3500
            });

            await CaricaDati();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore Analisi AI",
                Detail = ex.Message,
                Duration = 4000
            });
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task EliminaCommento(Commento target)
    {
        if (isActionLoading) return;
        isActionLoading = true;

        try
        {
            bool conferma = await DialogService.Confirm(
                "Sei sicuro di voler eliminare questo commento?", 
                "Conferma Eliminazione", 
                new ConfirmOptions() { OkButtonText = "Sì, Elimina", CancelButtonText = "Annulla" }) ?? false;

            if (conferma)
            {
                using var context = await DbFactory.CreateDbContextAsync();

                await context.Commenti
                    .Where(c => c.ID_Commento == target.ID_Commento)
                    .ExecuteDeleteAsync();

                commenti.Remove(target);
                commentiFiltrati.Remove(target);

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Commento Rimosso",
                    Detail = "Il commento è stato eliminato con successo.",
                    Duration = 2500
                });

                if (grid != null) await grid.Reload();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore Eliminazione",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
        }
    }

    private string GetBadgeColor(string? sentiment) => (sentiment?.ToLower()) switch
    {
        "positive" => "bg-success",
        "neutral" => "bg-secondary",
        "negative" => "bg-danger",
        "mixed" => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}