@page "/admin/comments"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using PostIn.Data
@using PostIn.Data.Entities
@using Radzen
@using Radzen.Blazor

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Gestione Commenti - Admin PostIn</PageTitle>

<RadzenNotification />
<RadzenDialog />

<div class="mx-auto" style="max-width: 74em;">

    <!-- INTESTAZIONE ADMIN -->
    <header class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger px-2.5 py-1 text-uppercase fw-bold" style="font-size: 0.7rem; border-radius: 0.35rem; letter-spacing: 0.05em;">
                    Admin
                </span>
                <h1 class="h3 fw-bold text-dark mb-0">Moderazione Commenti</h1>
            </div>
            <p class="text-muted small mb-0">Supervisiona, analizza e modera tutti i commenti pubblicati sotto gli articoli</p>
        </div>

        <span class="count-badge-header">
            <strong>@commenti.Count</strong> @(commenti.Count == 1 ? "commento totale" : "commenti totali")
        </span>
    </header>

    <!-- NAVIGAZIONE ADMIN -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <a href="/admin/users" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="group" Style="font-size: 0.95em;" class="me-1" /> Utenti
        </a>
        <a href="/admin/categories" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="label" Style="font-size: 0.95em;" class="me-1" /> Categorie
        </a>
        <a href="/admin/posts" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="article" Style="font-size: 0.95em;" class="me-1" /> Articoli
        </a>
        <a href="/admin/comments" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-active">
            <RadzenIcon Icon="forum" Style="font-size: 0.95em;" class="me-1" /> Commenti
        </a>
    </div>

    <!-- FILTRI DI RICERCA -->
    <RadzenCard class="rz-shadow-sm p-3 mb-4" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <div class="row g-3 align-items-end">
            <div class="col-md-6 col-lg-6">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">
                    Cerca nel Testo, Autore o Titolo Post
                </label>
                <div class="input-group" style="border-radius: 0.55rem; overflow: hidden;">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <RadzenIcon Icon="search" Style="font-size: 1.1em;" />
                    </span>
                    <input type="text"
                           class="form-control border-start-0 modern-input"
                           placeholder="Cerca parole chiave, utente o titolo articolo..."
                           value="@filtroTesto"
                           @oninput="OnFiltroTestoChanged" />
                </div>
            </div>

            <div class="col-md-4 col-lg-4">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">
                    Data di Pubblicazione
                </label>
                <RadzenDatePicker Value="@filtroData" 
                                  ValueChanged="@((DateTime? val) => OnFiltroDataChanged(val))"
                                  DateFormat="dd/MM/yyyy" 
                                  Placeholder="gg/mm/aaaa"
                                  Style="width: 100%; border-radius: 0.55rem;" />
            </div>

            <div class="col-md-2 col-lg-2 text-end">
                <RadzenButton Icon="filter_alt_off"
                              Text="Azzera"
                              Variant="Variant.Outlined"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Medium"
                              Style="border-radius: 0.55rem; width: 100%;"
                              Click="ResetFiltri" />
            </div>
        </div>
    </RadzenCard>

    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <span class="text-muted small">
            Visualizzati <strong>@commentiFiltrati.Count</strong> di <strong>@commenti.Count</strong> commenti
        </span>
    </div>

    <!-- TABELLA COMMENTI -->
    <RadzenCard class="rz-shadow-sm p-0 mb-5 overflow-hidden" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <RadzenDataGrid @ref="grid"
                        Data="@commentiFiltrati"
                        TItem="Commento"
                        IsLoading="@isLoading"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Pagina {0} di {1} ({2} commenti)"
                        EmptyText="Nessun commento trovato con i criteri selezionati."
                        class="rz-admin-grid">
            <Columns>

                <!-- Autore -->
                <RadzenDataGridColumn TItem="Commento" Property="Autore.Cognome" Title="Autore" MinWidth="180px">
                    <Template Context="c">
                        <div class="d-flex align-items-center gap-2 py-1">
                            <DiceBearAvatar Email="@c.Autore?.Username" Style="width: 2.3em; height: 2.3em; border-radius: 0.45rem; flex-shrink: 0;" />
                            <div class="min-w-0">
                                <span class="fw-bold text-dark d-block small">
                                    @(c.Autore != null ? $"{c.Autore.Nome} {c.Autore.Cognome}" : "Anonimo")
                                </span>
                                <span class="text-muted" style="font-size: 0.72rem;">@@@c.Autore?.Username</span>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Testo Commento -->
                <RadzenDataGridColumn TItem="Commento" Property="TestoCommento" Title="Commento" MinWidth="240px">
                    <Template Context="c">
                        <div class="p-2 rounded-2 bg-light border text-dark" style="font-size: 0.85rem; line-height: 1.45; word-break: break-word;">
                            @c.TestoCommento
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Articolo Collegato -->
                <RadzenDataGridColumn TItem="Commento" Property="Articolo.Titolo" Title="Articolo" MinWidth="170px">
                    <Template Context="c">
                        @if (c.Articolo != null)
                        {
                            <a href="/post/@c.FK_Articolo"
                               class="fw-semibold text-dark text-decoration-none admin-comment-link d-block text-truncate small"
                               title="@c.Articolo.Titolo">
                                <RadzenIcon Icon="article" Style="font-size: 0.9em;" class="me-1 text-muted" />
                                @c.Articolo.Titolo
                            </a>
                            <span class="text-muted" style="font-size: 0.7rem;">ID: #@c.FK_Articolo</span>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">Articolo rimosso</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <!-- Data -->
                <RadzenDataGridColumn TItem="Commento" 
                                    Property="DataPubblicazione" 
                                    Title="Data" 
                                    Width="140px"
                                    FormatString="{0:dd/MM/yy, HH:mm}">
                    <Template Context="c">
                        <span class="text-muted small" style="font-size: 0.78rem;">
                            @c.DataPubblicazione.ToLocalTime().ToString("dd/MM/yy, HH:mm")
                        </span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Azioni -->
                <RadzenDataGridColumn TItem="Commento" Title="Azioni" Width="110px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                    <Template Context="c">
                        <div class="d-flex justify-content-end gap-1.5 pe-2">
                            @if (c.Articolo != null)
                            {
                                <a href="/post/@c.FK_Articolo"
                                   class="btn btn-sm btn-outline-secondary"
                                   style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                                   title="Vedi nel Post">
                                    <RadzenIcon Icon="visibility" Style="font-size: 0.9em;" />
                                </a>
                            }
                            <RadzenButton Icon="delete"
                                          Variant="Variant.Outlined"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                                          Title="Elimina Commento"
                                          Disabled="@isActionLoading"
                                          Click="() => EliminaCommento(c)" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</div>

@code {
    private RadzenDataGrid<Commento>? grid;
    private bool isLoading = true;
    private bool isActionLoading = false;

    private List<Commento> commenti = new();
    private List<Commento> commentiFiltrati = new();
    private string filtroTesto = string.Empty;
    private DateTime? filtroData;

    protected override async Task OnInitializedAsync()
    {
        await CaricaCommenti();
    }

    private async Task CaricaCommenti()
    {
        isLoading = true;
        try
        {
            commenti = await DbContext.Commenti
                .AsNoTracking()
                .AsSplitQuery()
                .Include(c => c.Autore)
                .Include(c => c.Articolo)
                .OrderByDescending(c => c.DataPubblicazione)
                .ToListAsync();

            ApplicaFiltri();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore di Caricamento",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplicaFiltri()
    {
        commentiFiltrati = commenti.Where(c =>
            (string.IsNullOrWhiteSpace(filtroTesto) ||
             c.TestoCommento.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase) ||
             (c.Autore != null && $"{c.Autore.Nome} {c.Autore.Cognome}".Contains(filtroTesto, StringComparison.OrdinalIgnoreCase)) ||
             (c.Autore != null && c.Autore.Username.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase)) ||
             (c.Articolo != null && c.Articolo.Titolo.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase))) &&
            (!filtroData.HasValue || c.DataPubblicazione.Date == filtroData.Value.Date)).ToList();
    }

    private void OnFiltroTestoChanged(ChangeEventArgs e)
    {
        filtroTesto = e.Value?.ToString() ?? string.Empty;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void OnFiltroDataChanged(DateTime? value)
    {
        filtroData = value;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void ResetFiltri()
    {
        filtroTesto = string.Empty;
        filtroData = null;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private async Task EliminaCommento(Commento target)
    {
        if (isActionLoading) return;
        isActionLoading = true;

        try
        {
            // Determina il nome dell'autore in modo sicuro
            string nomeAutore = target.Autore != null 
                ? $"{target.Autore.Nome} {target.Autore.Cognome}" 
                : "un utente rimosso/anonimo";

            // Mostra il popup di conferma
            bool conferma = await DialogService.Confirm(
                $"Sei sicuro di voler eliminare il commento scritto da {nomeAutore}?", 
                "Conferma Eliminazione", 
                new ConfirmOptions() { OkButtonText = "Sì, Elimina", CancelButtonText = "Annulla" }) ?? false;

            // Se l'utente clicca "Sì", procedi con l'eliminazione
            if (conferma)
            {
                await DbContext.Commenti
                    .Where(c => c.ID_Commento == target.ID_Commento)
                    .ExecuteDeleteAsync();

                commenti.Remove(target);
                commentiFiltrati.Remove(target);

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Commento Rimosso",
                    Detail = "Il commento è stato eliminato con successo.",
                    Duration = 2500
                });

                if (grid != null)
                {
                    await grid.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore Eliminazione",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
        }
    }
}