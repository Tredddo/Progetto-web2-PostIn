@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using PostIn.Data
@using PostIn.Data.Entities
@using Radzen
@using Radzen.Blazor

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Gestione Utenti - Admin PostIn</PageTitle>

<RadzenNotification />
<RadzenDialog />

<div class="mx-auto" style="max-width: 74em;">

    <!-- INTESTAZIONE ADMIN -->
    <header class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger px-2.5 py-1 text-uppercase fw-bold" style="font-size: 0.7rem; border-radius: 0.35rem; letter-spacing: 0.05em;">
                    Admin
                </span>
                <h1 class="h3 fw-bold text-dark mb-0">Gestione Utenti</h1>
            </div>
            <p class="text-muted small mb-0">Supervisiona i profili aziendali, crea nuovi account e gestisci ruoli e permessi</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="count-badge-header">
                Totale: <strong>@dipendenti.Count</strong>
            </span>
            <span class="admin-count-badge">
                Admin: <strong>@dipendenti.Count(d => d.Ruolo == 1)</strong>
            </span>
        </div>
    </header>

    <!-- NAVIGAZIONE ADMIN -->
    <div class="d-flex gap-2 mb-4 flex-wrap align-items-center justify-content-between">
        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/users" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-active">
                <RadzenIcon Icon="group" Style="font-size: 0.95em;" class="me-1" /> Utenti
            </a>
            <a href="/admin/categories" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
                <RadzenIcon Icon="label" Style="font-size: 0.95em;" class="me-1" /> Categorie
            </a>
            <a href="/admin/posts" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
                <RadzenIcon Icon="article" Style="font-size: 0.95em;" class="me-1" /> Articoli
            </a>
            <a href="/admin/comments" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
                <RadzenIcon Icon="forum" Style="font-size: 0.95em;" class="me-1" /> Commenti
            </a>
        </div>

        <RadzenButton Icon="@(mostraFormNuovoUtente ? "expand_less" : "person_add")"
                      Text="@(mostraFormNuovoUtente ? "Chiudi Modulo" : "Nuovo Account")"
                      ButtonStyle="@(mostraFormNuovoUtente ? ButtonStyle.Secondary : ButtonStyle.Primary)"
                      Size="ButtonSize.Small"
                      Style="border-radius: 0.55rem; font-weight: 600;"
                      Click="() => mostraFormNuovoUtente = !mostraFormNuovoUtente" />
    </div>

    <!-- MODULO CREAZIONE NUOVO ACCOUNT (COLLAPSIBILE) -->
    @if (mostraFormNuovoUtente)
    {
        <RadzenCard class="rz-shadow-sm p-4 mb-4 border-primary border-opacity-25" Style="border-radius: 0.85rem; background: #fdfdfe;">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
                    <RadzenIcon Icon="person_add" Style="font-size: 1.2em; color: #4f46e5;" />
                    Crea Nuovo Account Dipendente
                </h2>
                <button type="button" class="btn-close" aria-label="Chiudi" @onclick="() => mostraFormNuovoUtente = false"></button>
            </div>

            <EditForm Model="nuovoUtenteModel" OnValidSubmit="CreaNuovoAccount" FormName="nuovoUtenteForm">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Nome <span class="text-danger">*</span></label>
                        <InputText @bind-Value="nuovoUtenteModel.Nome" class="form-control modern-input" placeholder="es. Mario" />
                        <ValidationMessage For="() => nuovoUtenteModel.Nome" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Cognome <span class="text-danger">*</span></label>
                        <InputText @bind-Value="nuovoUtenteModel.Cognome" class="form-control modern-input" placeholder="es. Rossi" />
                        <ValidationMessage For="() => nuovoUtenteModel.Cognome" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Username aziendale <span class="text-danger">*</span></label>
                        <div class="input-group" style="border-radius: 0.55rem; overflow: hidden;">
                            <span class="input-group-text bg-light text-muted border-end-0">@@</span>
                            <InputText @bind-Value="nuovoUtenteModel.Username" class="form-control border-start-0 modern-input" placeholder="m.rossi" />
                        </div>
                        <ValidationMessage For="() => nuovoUtenteModel.Username" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Password Iniziale <span class="text-danger">*</span></label>
                        <InputText type="password" @bind-Value="nuovoUtenteModel.Password" class="form-control modern-input" placeholder="Min. 6 caratteri" />
                        <ValidationMessage For="() => nuovoUtenteModel.Password" class="text-danger small mt-1" />
                    </div>

                    <!-- DROPDOWN RUOLO RADZEN -->
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label fw-bold small text-muted text-uppercase" style="font-size: 0.72rem;">Ruolo Account</label>
                        <RadzenDropDown @bind-Value="nuovoUtenteModel.Ruolo"
                                        Data="@opzioniRuolo"
                                        TextProperty="Nome"
                                        ValueProperty="Valore"
                                        Style="width: 100%; border-radius: 0.55rem;" />
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
                        <RadzenButton Text="Annulla"
                                      Variant="Variant.Outlined"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Size="ButtonSize.Small"
                                      Style="border-radius: 0.55rem;"
                                      Click="() => mostraFormNuovoUtente = false" />

                        <RadzenButton Icon="check"
                                      Text="Salva Account"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      ButtonType="ButtonType.Submit"
                                      IsBusy="@isActionLoading"
                                      Style="background-color: #4f46e5; border-radius: 0.55rem; font-weight: 600;" />
                    </div>
                </div>
            </EditForm>
        </RadzenCard>
    }

    <!-- PANNELLO FILTRI -->
    <RadzenCard class="rz-shadow-sm p-3 mb-4" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <div class="row g-3 align-items-end">
            <div class="col-lg-5 col-md-6">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">Cerca Dipendente</label>
                <div class="input-group" style="border-radius: 0.55rem; overflow: hidden;">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <RadzenIcon Icon="search" Style="font-size: 1.1em;" />
                    </span>
                    <input type="text" class="form-control border-start-0 modern-input"
                           placeholder="Cerca per nome, cognome o username..."
                           value="@filtroTesto"
                           @oninput="OnFiltroTestoChanged" />
                </div>
            </div>
            <div class="col-lg-3 col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">Ruolo</label>
                <RadzenDropDown Value="@filtroRuolo"
                                ValueChanged="@((int? val) => OnFiltroRuoloChanged(val))"
                                Data="@opzioniFiltroRuolo"
                                TextProperty="Nome"
                                ValueProperty="Valore"
                                Placeholder="Tutti i ruoli"
                                AllowClear="true"
                                Class="w-100"
                                Style="border-radius: 0.55rem;" />
            </div>
            <div class="col-lg-3 col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">Stato</label>
                <RadzenDropDown Value="@filtroStato"
                                ValueChanged="@((int? val) => OnFiltroStatoChanged(val))"
                                Data="@opzioniFiltroStato"
                                TextProperty="Nome"
                                ValueProperty="Valore"
                                Placeholder="Tutti gli stati"
                                AllowClear="true"
                                Class="w-100"
                                Style="border-radius: 0.55rem;" />
            </div>
            <div class="col-lg-1 col-md-12 text-end">
                <RadzenButton Icon="filter_alt_off"
                              Variant="Variant.Outlined"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Medium"
                              Style="border-radius: 0.55rem; width: 100%;"
                              Title="Azzera filtri"
                              Click="ResetFiltri" />
            </div>
        </div>
    </RadzenCard>

    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <span class="text-muted small">
            Visualizzati <strong>@dipendentiFiltrati.Count</strong> di <strong>@dipendenti.Count</strong> utenti
        </span>
    </div>

    <!-- TABELLA UTENTI -->
    <RadzenCard class="rz-shadow-sm p-0 mb-5 overflow-hidden" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <RadzenDataGrid @ref="grid"
                        Data="@dipendentiFiltrati"
                        TItem="Dipendente"
                        IsLoading="@isLoading"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Pagina {0} di {1} ({2} utenti)"
                        EmptyText="Nessun utente trovato con i filtri impostati."
                        class="rz-admin-grid">
            <Columns>
                <!-- ID -->
                <RadzenDataGridColumn TItem="Dipendente"
                                     Property="ID_Dipendente"
                                     Title="ID"
                                     Width="80px"
                                     TextAlign="TextAlign.Center">
                    <Template Context="d">
                        <span class="text-muted small fw-medium">#@d.ID_Dipendente</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Dipendente -->
                <RadzenDataGridColumn TItem="Dipendente"
                                     Property="Cognome"
                                     Title="Dipendente"
                                     MinWidth="220px">
                    <Template Context="d">
                        @{ var isCurrentUser = d.ID_Dipendente == currentUserId; }
                        <div class="d-flex align-items-center gap-3 py-1">
                            <DiceBearAvatar Email="@d.Username"
                                           Style="width: 2.3em; height: 2.3em; border-radius: 0.5rem; flex-shrink: 0;" />
                            <div class="d-flex flex-column min-w-0">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@d.Nome @d.Cognome</span>
                                    @if (isCurrentUser)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border"
                                              style="font-size: 0.65rem; border-radius: 0.35rem; padding: 0.2em 0.45em;">Tu</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Username -->
                <RadzenDataGridColumn TItem="Dipendente"
                                     Property="Username"
                                     Title="Username"
                                     MinWidth="140px">
                    <Template Context="d">
                        <span class="text-muted small">@@@d.Username</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Ruolo -->
                <RadzenDataGridColumn TItem="Dipendente"
                                     Property="Ruolo"
                                     Title="Ruolo"
                                     Width="120px"
                                     TextAlign="TextAlign.Center">
                    <Template Context="d">
                        @if (d.Ruolo == 1)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: 0.72rem; border-radius: 0.35rem;">
                                <RadzenIcon Icon="shield" Style="font-size: 0.85em;" class="me-0.5" /> Admin
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.72rem; border-radius: 0.35rem;">Utente</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <!-- Stato Account -->
                <RadzenDataGridColumn TItem="Dipendente"
                                     Property="StatoAccount"
                                     Title="Stato"
                                     Width="130px"
                                     TextAlign="TextAlign.Center">
                    <Template Context="d">
                        @if (d.StatoAccount == 1)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.72rem; border-radius: 0.35rem;">
                                <RadzenIcon Icon="check_circle" Style="font-size: 0.85em;" class="me-0.5" /> Attivo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1" style="font-size: 0.72rem; border-radius: 0.35rem;">
                                <RadzenIcon Icon="block" Style="font-size: 0.85em;" class="me-0.5" /> Disabilitato
                            </span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <!-- Ultimo Accesso -->
                <RadzenDataGridColumn TItem="Dipendente"
                                     Property="UltimoAccesso"
                                     Title="Ultimo Accesso"
                                     MinWidth="150px">
                    <Template Context="d">
                        <span class="text-muted small" style="font-size: 0.78rem;">
                            @(d.UltimoAccesso.HasValue
                                ? d.UltimoAccesso.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                : "Mai effettuato")
                        </span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Azioni -->
                <RadzenDataGridColumn TItem="Dipendente"
                                     Title="Azioni"
                                     Width="110px"
                                     Sortable="false"
                                     TextAlign="TextAlign.Right">
                    <Template Context="d">
                        @{ var isSelf = d.ID_Dipendente == currentUserId; }
                        <div class="d-flex justify-content-end gap-1.5 pe-2">
                            <RadzenButton Icon="@(d.Ruolo == 1 ? "remove_moderator" : "admin_panel_settings")"
                                          Variant="Variant.Outlined"
                                          ButtonStyle="@(d.Ruolo == 1 ? ButtonStyle.Secondary : ButtonStyle.Primary)"
                                          Size="ButtonSize.Small"
                                          Style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                                          Disabled="@(isActionLoading || isSelf)"
                                          Title="@(isSelf ? "Non puoi modificare il tuo stesso ruolo" : (d.Ruolo == 1 ? "Revoca privilegi Admin" : "Promuovi ad Admin"))"
                                          Click="() => ToggleRuolo(d)" />

                            <RadzenButton Icon="@(d.StatoAccount == 1 ? "block" : "check_circle")"
                                          Variant="Variant.Outlined"
                                          ButtonStyle="@(d.StatoAccount == 1 ? ButtonStyle.Warning : ButtonStyle.Success)"
                                          Size="ButtonSize.Small"
                                          Style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                                          Disabled="@(isActionLoading || isSelf)"
                                          Title="@(isSelf ? "Non puoi disabilitare il tuo account" : (d.StatoAccount == 1 ? "Disabilita account" : "Riattiva account"))"
                                          Click="() => ToggleStato(d)" />

                            <!-- NUOVO BOTTONE PER ELIMINARE -->
                            <RadzenButton Icon="delete"
                                          Variant="Variant.Outlined"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                                          Disabled="@(isActionLoading || isSelf)"
                                          Title="@(isSelf ? "Non puoi eliminare il tuo account" : "Elimina account definitivamente")"
                                          Click="() => EliminaUtente(d)" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</div>

@code {
    private RadzenDataGrid<Dipendente>? grid;
    private bool isLoading = true;
    private bool isActionLoading = false;
    private bool mostraFormNuovoUtente = false;
    private int currentUserId = 0;
    
    private List<Dipendente> dipendenti = new();
    private List<Dipendente> dipendentiFiltrati = new();
    private NuovoUtenteModel nuovoUtenteModel = new();

    private string filtroTesto = string.Empty;
    private int? filtroRuolo;
    private int? filtroStato;

    private readonly List<OpzioneFiltro> opzioniRuolo = new()
    {
        new OpzioneFiltro { Valore = 0, Nome = "Utente Standard (Dipendente)" },
        new OpzioneFiltro { Valore = 1, Nome = "Amministratore (Admin)" }
    };

    private readonly List<OpzioneFiltro> opzioniFiltroRuolo = new()
    {
        new OpzioneFiltro { Valore = 0, Nome = "Utente" },
        new OpzioneFiltro { Valore = 1, Nome = "Admin" }
    };

    private readonly List<OpzioneFiltro> opzioniFiltroStato = new()
    {
        new OpzioneFiltro { Valore = 1, Nome = "Attivo" },
        new OpzioneFiltro { Valore = 0, Nome = "Disabilitato" }
    };

    private class OpzioneFiltro
    {
        public int Valore { get; set; }
        public string Nome { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdClaim, out currentUserId);

        await CaricaDipendenti();
    }

    private async Task CaricaDipendenti()
    {
        isLoading = true;
        try
        {
            dipendenti = await DbContext.Dipendenti
                .AsNoTracking()
                .OrderBy(d => d.Cognome)
                .ThenBy(d => d.Nome)
                .ToListAsync();

            ApplicaFiltri();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore di Caricamento",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplicaFiltri()
    {
        dipendentiFiltrati = dipendenti.Where(d =>
            (string.IsNullOrWhiteSpace(filtroTesto) ||
             $"{d.Nome} {d.Cognome}".Contains(filtroTesto, StringComparison.OrdinalIgnoreCase) ||
             d.Username.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase)) &&
            (!filtroRuolo.HasValue || d.Ruolo == filtroRuolo.Value) &&
            (!filtroStato.HasValue || d.StatoAccount == filtroStato.Value)).ToList();
    }

    private void OnFiltroTestoChanged(ChangeEventArgs e)
    {
        filtroTesto = e.Value?.ToString() ?? string.Empty;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void OnFiltroRuoloChanged(int? value)
    {
        filtroRuolo = value;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void OnFiltroStatoChanged(int? value)
    {
        filtroStato = value;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void ResetFiltri()
    {
        filtroTesto = string.Empty;
        filtroRuolo = null;
        filtroStato = null;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private async Task CreaNuovoAccount()
    {
        if (isActionLoading) return;
        isActionLoading = true;

        var usernamePuro = nuovoUtenteModel.Username.Trim().ToLowerInvariant().Replace("@", "");

        try
        {
            var esiste = await DbContext.Dipendenti.AnyAsync(d => d.Username.ToLower() == usernamePuro);
            if (esiste)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Username Occupato",
                    Detail = $"L'username @{usernamePuro} è già associato a un altro dipendente.",
                    Duration = 3500
                });
                return;
            }

            var nuovoDipendente = new Dipendente
            {
                Nome = nuovoUtenteModel.Nome.Trim(),
                Cognome = nuovoUtenteModel.Cognome.Trim(),
                Username = usernamePuro,
                PasswordHash = PasswordHelper.HashPassword(nuovoUtenteModel.Password),
                Ruolo = nuovoUtenteModel.Ruolo,
                StatoAccount = 1,
                UltimoAccesso = DateTime.UtcNow
            };

            DbContext.Dipendenti.Add(nuovoDipendente);
            await DbContext.SaveChangesAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Account Creato",
                Detail = $"Il profilo di {nuovoDipendente.Nome} {nuovoDipendente.Cognome} (@{nuovoDipendente.Username}) è stato aggiunto.",
                Duration = 3000
            });

            nuovoUtenteModel = new();
            mostraFormNuovoUtente = false;
            
            await CaricaDipendenti();
            if (grid != null) await grid.Reload();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore Salvataggio",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
        }
    }

    private async Task ToggleRuolo(Dipendente target)
    {
        if (isActionLoading || target.ID_Dipendente == currentUserId) return;
        isActionLoading = true;

        try
        {
            var nuovoValoreRuolo = target.Ruolo == 1 ? 0 : 1;

            await DbContext.Dipendenti
                .Where(d => d.ID_Dipendente == target.ID_Dipendente)
                .ExecuteUpdateAsync(s => s.SetProperty(d => d.Ruolo, nuovoValoreRuolo));

            target.Ruolo = nuovoValoreRuolo;

            var nuovoRuoloLabel = target.Ruolo == 1 ? "Amministratore" : "Utente standard";

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Ruolo Aggiornato",
                Detail = $"{target.Nome} {target.Cognome} è ora {nuovoRuoloLabel}.",
                Duration = 2500
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = $"Impossibile modificare il ruolo: {ex.Message}",
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
        }
    }

    private async Task ToggleStato(Dipendente target)
    {
        if (isActionLoading || target.ID_Dipendente == currentUserId) return;
        isActionLoading = true;

        try
        {
            var nuovoStato = target.StatoAccount == 1 ? 0 : 1;

            await DbContext.Dipendenti
                .Where(d => d.ID_Dipendente == target.ID_Dipendente)
                .ExecuteUpdateAsync(s => s.SetProperty(d => d.StatoAccount, nuovoStato));

            target.StatoAccount = nuovoStato;

            var statoDescrizione = target.StatoAccount == 1 ? "riattivato" : "disabilitato";

            NotificationService.Notify(new NotificationMessage
            {
                Severity = target.StatoAccount == 1 ? NotificationSeverity.Success : NotificationSeverity.Warning,
                Summary = "Stato Modificato",
                Detail = $"Account di {target.Nome} {target.Cognome} {statoDescrizione}.",
                Duration = 2500
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = $"Impossibile aggiornare lo stato: {ex.Message}",
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
        }
    }

    private async Task EliminaUtente(Dipendente target)
    {
        if (isActionLoading || target.ID_Dipendente == currentUserId) return;
        isActionLoading = true;

        try
        {
            bool conferma = await DialogService.Confirm($"Sei sicuro di voler eliminare definitivamente l'utente {target.Nome} {target.Cognome} (@{target.Username})?", "Conferma Eliminazione", new ConfirmOptions() { OkButtonText = "Sì, Elimina", CancelButtonText = "Annulla" }) ?? false;
            if (conferma)
            {
                // Verifica di vincoli di Foreign Key (se presenti, l'operazione fallirà e scatterà il catch)
                DbContext.Dipendenti.Remove(target);
                await DbContext.SaveChangesAsync();

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Utente Eliminato",
                    Detail = $"L'account di {target.Nome} {target.Cognome} è stato rimosso con successo.",
                    Duration = 3000
                });

                // Ricarica la lista per mostrare la tabella aggiornata
                await CaricaDipendenti();
                if (grid != null) await grid.Reload();
            }
        }
        catch (DbUpdateException)
        {
            // Gestione dell'errore di integrità referenziale (DeleteBehavior.Restrict)
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore di Eliminazione",
                Detail = "Impossibile eliminare l'utente. Potrebbe aver pubblicato articoli o commenti. Disabilita l'account invece di eliminarlo.",
                Duration = 5000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore",
                Detail = $"Si è verificato un errore imprevisto: {ex.Message}",
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
        }
    }

    public class NuovoUtenteModel
    {
        [Required(ErrorMessage = "Il nome è obbligatorio.")]
        [StringLength(50, ErrorMessage = "Massimo 50 caratteri.")]
        public string Nome { get; set; } = string.Empty;

        [Required(ErrorMessage = "Il cognome è obbligatorio.")]
        [StringLength(50, ErrorMessage = "Massimo 50 caratteri.")]
        public string Cognome { get; set; } = string.Empty;

        [Required(ErrorMessage = "L'username è obbligatorio.")]
        [StringLength(50, ErrorMessage = "Massimo 50 caratteri.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "La password è obbligatoria.")]
        [MinLength(6, ErrorMessage = "La password deve avere almeno 6 caratteri.")]
        public string Password { get; set; } = string.Empty;

        public int Ruolo { get; set; } = 0;
    }
