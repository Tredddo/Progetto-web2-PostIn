@page "/admin/posts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using PostIn.Data
@using PostIn.Data.Entities
@using Radzen
@using Radzen.Blazor

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Gestione Articoli - Admin PostIn</PageTitle>

<RadzenNotification />
<RadzenDialog />

<div class="mx-auto" style="max-width: 74em;">

    <!-- INTESTAZIONE ADMIN -->
    <header class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger px-2.5 py-1 text-uppercase fw-bold" style="font-size: 0.7rem; border-radius: 0.35rem; letter-spacing: 0.05em;">
                    Admin
                </span>
                <h1 class="h3 fw-bold text-dark mb-0">Gestione Articoli</h1>
            </div>
            <p class="text-muted small mb-0">Supervisione, analisi statistiche e moderazione di tutte le pubblicazioni aziendali</p>
        </div>
        <span class="count-badge-header">
            <strong>@articoli.Count</strong> @(articoli.Count == 1 ? "articolo totale" : "articoli totali")
        </span>
    </header>

    <!-- NAVIGAZIONE ADMIN -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <a href="/admin/users" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="group" Style="font-size: 0.95em;" class="me-1" /> Utenti
        </a>
        <a href="/admin/categories" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="label" Style="font-size: 0.95em;" class="me-1" /> Categorie
        </a>
        <a href="/admin/posts" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-active">
            <RadzenIcon Icon="article" Style="font-size: 0.95em;" class="me-1" /> Articoli
        </a>
        <a href="/admin/comments" class="btn btn-sm px-3 py-1.5 fw-medium admin-nav-btn admin-nav-inactive">
            <RadzenIcon Icon="forum" Style="font-size: 0.95em;" class="me-1" /> Commenti
        </a>
    </div>

    <!-- PANNELLO FILTRI -->
    <RadzenCard class="rz-shadow-sm p-3 mb-4" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">Cerca Titolo o Autore</label>
                <div class="input-group" style="border-radius: 0.55rem; overflow: hidden;">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <RadzenIcon Icon="search" Style="font-size: 1.1em;" />
                    </span>
                    <input type="text" class="form-control border-start-0 modern-input"
                           placeholder="es. Titolo post o username..."
                           value="@filtroTesto"
                           @oninput="OnFiltroTestoChanged" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">Categoria</label>
                <RadzenDropDown Value="@filtroCategoria"
                                ValueChanged="@((int? val) => OnFiltroCategoriaChanged(val))"
                                Data="@tutteCategorie"
                                TextProperty="NomeCategoria"
                                ValueProperty="ID_Categoria"
                                Placeholder="Tutte le categorie"
                                AllowClear="true"
                                Class="w-100"
                                Style="border-radius: 0.55rem;">
                    <Template Context="cat">
                        #@cat.NomeCategoria
                    </Template>
                </RadzenDropDown>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">Dal</label>
                <RadzenDatePicker Value="@filtroDataDa" 
                                  ValueChanged="@((DateTime? val) => OnFiltroDataDaChanged(val))"
                                  DateFormat="dd/MM/yyyy" 
                                  Placeholder="gg/mm/aaaa"
                                  Style="width: 100%; border-radius: 0.55rem;" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.73rem; letter-spacing: 0.05em;">Al</label>
                <RadzenDatePicker Value="@filtroDataA" 
                                  ValueChanged="@((DateTime? val) => OnFiltroDataAChanged(val))"
                                  DateFormat="dd/MM/yyyy" 
                                  Placeholder="gg/mm/aaaa"
                                  Style="width: 100%; border-radius: 0.55rem;" />
            </div>
            <div class="col-lg-1 col-md-4 text-end">
                <RadzenButton Icon="filter_alt_off"
                              Variant="Variant.Outlined"
                              ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Medium"
                              Style="border-radius: 0.55rem; width: 100%;"
                              Title="Azzera filtri"
                              Click="ResetFiltri" />
            </div>
        </div>
    </RadzenCard>

    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <span class="text-muted small">
            Visualizzati <strong>@articoliFiltrati.Count</strong> di <strong>@articoli.Count</strong> articoli
        </span>
    </div>

    <!-- TABELLA ARTICOLI -->
    <RadzenCard class="rz-shadow-sm p-0 mb-5 overflow-hidden" Style="border-radius: 0.85rem; border: 1px solid #e2e8f0; background: #ffffff;">
        <RadzenDataGrid @ref="grid"
                        Data="@articoliFiltrati"
                        TItem="AdminArticoloViewModel"
                        IsLoading="@isLoading"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="10"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        ShowPagingSummary="true"
                        PagingSummaryFormat="Pagina {0} di {1} ({2} articoli)"
                        EmptyText="Nessun articolo corrisponde ai filtri impostati."
                        class="rz-admin-grid">
            <Columns>

                <!-- Articolo -->
                <RadzenDataGridColumn TItem="AdminArticoloViewModel" Property="Titolo" Title="Articolo" MinWidth="220px">
                    <Template Context="art">
                        <div class="d-flex align-items-center gap-2 py-1">
                            @if (!string.IsNullOrWhiteSpace(art.ImmagineCopertina))
                            {
                                <img src="@art.ImmagineCopertina" alt=""
                                     class="grid-thumb"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="grid-thumb-placeholder" style="display:none;">
                                    <RadzenIcon Icon="article" Style="font-size: 1.1em; color: #94a3b8;" />
                                </div>
                            }
                            else
                            {
                                <div class="grid-thumb-placeholder">
                                    <RadzenIcon Icon="article" Style="font-size: 1.1em; color: #94a3b8;" />
                                </div>
                            }
                            <div class="min-w-0">
                                <a href="/post/@art.ID_Articolo"
                                   class="fw-semibold text-dark text-decoration-none admin-post-link d-block text-truncate"
                                   style="font-size: 0.87rem; max-width: 15rem;"
                                   title="@art.Titolo">@art.Titolo</a>
                                <span class="text-muted" style="font-size: 0.72rem;">ID #@art.ID_Articolo</span>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Autore -->
                <RadzenDataGridColumn TItem="AdminArticoloViewModel" Property="AutoreCognome" Title="Autore" MinWidth="160px">
                    <Template Context="art">
                        <div class="d-flex align-items-center gap-2">
                            <DiceBearAvatar Email="@art.AutoreUsername"
                                           Style="width: 2.2em; height: 2.2em; border-radius: 0.45rem; flex-shrink: 0;" />
                            <div class="min-w-0">
                                <span class="fw-semibold d-block text-dark text-truncate" style="font-size: 0.85rem; max-width: 11rem;">
                                    @art.AutoreNomeCompleto
                                </span>
                                <span class="text-muted" style="font-size: 0.72rem;">@@@art.AutoreUsername</span>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Categorie -->
                <RadzenDataGridColumn TItem="AdminArticoloViewModel" Title="Categorie" Width="140px" Sortable="false" Filterable="false">
                    <Template Context="art">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var cat in art.Categorie.Take(2))
                            {
                                <span class="category-badge">#@cat</span>
                            }
                            @if (art.Categorie.Count > 2)
                            {
                                <span class="badge bg-light text-muted border" style="font-size: 0.68rem; border-radius: 0.35rem;">
                                    +@(art.Categorie.Count - 2)
                                </span>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Data (gg/mm/aa) -->
                <RadzenDataGridColumn TItem="AdminArticoloViewModel" Property="DataOraCreazione" Title="Data" Width="110px">
                    <Template Context="art">
                        <span class="text-muted small" style="font-size: 0.82rem;">
                            @art.DataOraCreazione.ToLocalTime().ToString("dd/MM/yy")
                        </span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Stats -->
                <RadzenDataGridColumn TItem="AdminArticoloViewModel" Title="Stats" Width="120px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                    <Template Context="art">
                        <div class="d-flex align-items-center justify-content-center gap-2 text-muted" style="font-size: 0.82rem;">
                            <span title="Visualizzazioni" class="d-flex align-items-center gap-1">
                                <RadzenIcon Icon="visibility" Style="font-size: 1em; color: #64748b;" /> @art.VisualizzazioniCount
                            </span>
                            <span title="Like" class="d-flex align-items-center gap-1">
                                <RadzenIcon Icon="favorite" Style="font-size: 1em; color: #ef4444;" /> @art.LikesCount
                            </span>
                            <span title="Commenti" class="d-flex align-items-center gap-1">
                                <RadzenIcon Icon="chat_bubble" Style="font-size: 1em; color: #6366f1;" /> @art.CommentiCount
                            </span>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Azioni -->
                <RadzenDataGridColumn TItem="AdminArticoloViewModel" Title="Azioni" Width="100px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                    <Template Context="art">
                        <div class="d-flex justify-content-end gap-1 pe-1">
                            <a href="/post/@art.ID_Articolo"
                               class="btn btn-sm btn-outline-secondary"
                               style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                               title="Visualizza">
                                <RadzenIcon Icon="visibility" Style="font-size: 0.9em;" />
                            </a>
                            <RadzenButton Icon="delete"
                                          Variant="Variant.Outlined"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Style="border-radius: 0.45rem; padding: 0.25rem 0.5rem;"
                                          Title="Elimina"
                                          Disabled="@isActionLoading"
                                          Click="() => EliminaArticolo(art)" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</div>

@code {
    public class AdminArticoloViewModel
    {
        public int ID_Articolo { get; set; }
        public string Titolo { get; set; } = string.Empty;
        public string? ImmagineCopertina { get; set; }
        public DateTime DataOraCreazione { get; set; }
        public string AutoreNomeCompleto { get; set; } = string.Empty;
        public string AutoreCognome { get; set; } = string.Empty;
        public string AutoreUsername { get; set; } = string.Empty;
        public List<string> Categorie { get; set; } = new();
        public List<int> CategorieIds { get; set; } = new();
        public int VisualizzazioniCount { get; set; }
        public int LikesCount { get; set; }
        public int CommentiCount { get; set; }
    }

    private RadzenDataGrid<AdminArticoloViewModel>? grid;
    private bool isLoading = true;
    private bool isActionLoading = false;
    private CancellationTokenSource cts = new();

    private List<AdminArticoloViewModel> articoli = new();
    private List<AdminArticoloViewModel> articoliFiltrati = new();
    private List<Categoria> tutteCategorie = new();

    private string filtroTesto = string.Empty;
    private int? filtroCategoria;
    private DateTime? filtroDataDa;
    private DateTime? filtroDataA;

    protected override async Task OnInitializedAsync()
    {
        await CaricaDatiIniziali();
    }

    private async Task CaricaDatiIniziali()
    {
        isLoading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync(cts.Token);

            tutteCategorie = await context.Categorie
                .AsNoTracking()
                .OrderBy(c => c.NomeCategoria)
                .ToListAsync(cts.Token);

            articoli = await context.Articoli
                .AsNoTracking()
                .Select(a => new AdminArticoloViewModel
                {
                    ID_Articolo = a.ID_Articolo,
                    Titolo = a.Titolo,
                    ImmagineCopertina = a.ImmagineCopertina,
                    DataOraCreazione = a.DataOraCreazione,
                    AutoreNomeCompleto = a.Autore != null ? a.Autore.Nome + " " + a.Autore.Cognome : "Anonimo",
                    AutoreCognome = a.Autore != null ? a.Autore.Cognome : string.Empty,
                    AutoreUsername = a.Autore != null ? a.Autore.Username : string.Empty,
                    Categorie = a.ArticoloCategorie.Select(ac => ac.Categoria.NomeCategoria).ToList(),
                    CategorieIds = a.ArticoloCategorie.Select(ac => ac.FK_Categoria).ToList(),
                    VisualizzazioniCount = a.Visualizzazioni.Count(),
                    LikesCount = a.Likes.Count(),
                    CommentiCount = a.Commenti.Count()
                })
                .OrderByDescending(a => a.DataOraCreazione)
                .ToListAsync(cts.Token);

            ApplicaFiltri();
        }
        catch (OperationCanceledException)
        {
            // Query annullata in modo pulito al cambio pagina
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore Caricamento",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplicaFiltri()
    {
        articoliFiltrati = articoli.Where(a =>
            (string.IsNullOrWhiteSpace(filtroTesto) ||
             a.Titolo.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase) ||
             a.AutoreNomeCompleto.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase) ||
             a.AutoreUsername.Contains(filtroTesto, StringComparison.OrdinalIgnoreCase)) &&
            (!filtroCategoria.HasValue || a.CategorieIds.Contains(filtroCategoria.Value)) &&
            (!filtroDataDa.HasValue || a.DataOraCreazione.Date >= filtroDataDa.Value.Date) &&
            (!filtroDataA.HasValue || a.DataOraCreazione.Date <= filtroDataA.Value.Date)).ToList();
    }

    private void OnFiltroTestoChanged(ChangeEventArgs e)
    {
        filtroTesto = e.Value?.ToString() ?? string.Empty;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void OnFiltroCategoriaChanged(int? value)
    {
        filtroCategoria = value;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void OnFiltroDataDaChanged(DateTime? value)
    {
        filtroDataDa = value;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void OnFiltroDataAChanged(DateTime? value)
    {
        filtroDataA = value;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private void ResetFiltri()
    {
        filtroTesto = string.Empty;
        filtroCategoria = null;
        filtroDataDa = null;
        filtroDataA = null;
        ApplicaFiltri();
        if (grid != null) grid.FirstPage();
    }

    private async Task EliminaArticolo(AdminArticoloViewModel target)
    {
        if (isActionLoading) return;
        isActionLoading = true;

        try
        {
            bool conferma = await DialogService.Confirm(
                $"Sei sicuro di voler eliminare definitivamente l'articolo '{target.Titolo}' scritto da {target.AutoreNomeCompleto}?", 
                "Conferma Eliminazione", 
                new ConfirmOptions() { OkButtonText = "Sì, Elimina", CancelButtonText = "Annulla" }) ?? false;

            if (conferma)
            {
                using var context = await DbFactory.CreateDbContextAsync();

                await context.Articoli
                    .Where(a => a.ID_Articolo == target.ID_Articolo)
                    .ExecuteDeleteAsync();

                articoli.Remove(target);
                articoliFiltrati.Remove(target);

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Articolo Eliminato",
                    Detail = $"L'articolo '{target.Titolo}' è stato rimosso dalla piattaforma.",
                    Duration = 2500
                });

                if (grid != null)
                {
                    await grid.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errore Eliminazione",
                Detail = ex.Message,
                Duration = 3500
            });
        }
        finally
        {
            isActionLoading = false;
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}